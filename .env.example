# ==============================================================================
# Adaptive AI Firewall — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your deployment:
#   cp .env.example .env
# Note: Never commit your local .env file containing private credentials.
# ==============================================================================

# Backend API & Web Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Packet Interception Engine (Requires root / CAP_NET_ADMIN privileges)
NFQUEUE_NUM=0
PACKET_TIMEOUT_SECONDS=10.0
MIN_PACKETS_PER_FLOW=3

# Automated Mitigation & Blocking
BLOCK_DURATION_SECONDS=300
WHITELISTED_IPS=127.0.0.1,::1

# Machine Learning Anomaly Detection
ML_MODEL_PATH=ml_model/model.pkl
ML_SCALER_PATH=ml_model/scaler.pkl
ML_THRESHOLD_PATH=ml_model/threshold.pkl
ANOMALY_THRESHOLD=-0.05

# Log File Storage
LOGS_DIR=logs
REALTIME_FLOWS_LOG=logs/realtime_flows.json
FIREWALL_STATS_LOG=logs/stats.json
BLOCKED_IPS_LOG=logs/blocked_ips.json
